# قم بإعادة تسمية هذا الملف إلى custom.app_replace.list بعد تعديله حسب حاجتك
#
# أضف مسارات مجلدات/ملفات تطبيقات الحقن المتعارضة في الرومات المخصصة إلى هذه القائمة
# وسيتم استبدالها وإخفائها دون التعديل على ملفات النظام الرسمية (Systemlessly) لإلغاء تفعيلها

# رومات Xiaomi.eu
/product/app/XiaomiEUInject
/product/app/XiaomiEUInject-Stub

# رومات EliteRoms
/system/app/EliteDevelopmentModule
/system/app/XInjectModule

# رومات helluvaOS و hentaiOS
/system_ext/app/helluvaProductDevice*
/system_ext/app/helluvaProductSecretStub
/system_ext/app/hentaiLewdbSVTDummy

# رومات Evolution X
/system_ext/app/PifPrebuilt

# رومات PixelOS و YAAP
/system_ext/overlay/CertifiedPropsOverlay.apk