// قم بإعادة تسمية هذا الملف إلى custom.pif.json بعد الانتهاء من تعبئة البيانات
//
// هذه هي القيم الافتراضية المقترحة حالياً، ويمكنك إضافة المزيد من الحقول والخصائص حسب الحاجة
//
// يمكنك مراجعة المصدر android.os.Build للإطلاع على كافة الحقول والخصائص المقابلة لها:
// https://android.googlesource.com/platform/frameworks/base/+/master/core/java/android/os/Build.java

{
  // حقول البناء (Build Fields)
    "MANUFACTURER": "",
    "MODEL": "",
    "FINGERPRINT": "",
    "BRAND": "",
    "PRODUCT": "",
    "DEVICE": "",
    "RELEASE": "",
    "ID": "",
    "INCREMENTAL": "",
    "TYPE": "",
    "TAGS": "",
    "SECURITY_PATCH": "",
    "DEVICE_INITIAL_SDK_INT": "",

  // خصائص النظام (System Properties)
    "*.build.id": "",        // المقابلة للخاصية ro.build.id
    "*.security_patch": "",  // المقابلة للخاصية ro.build.version.security_patch
    "*api_level": "",        // المقابلة للخصائص ro.board.api_level و ro.board.first_api_level و ro.product.first_api_level و ro.vendor.api_level

  // الإعدادات المتقدمة (Advanced Settings)
    "spoofBuild": "1",
    "spoofProps": "1",
    "spoofProvider": "1",
    "spoofSignature": "0",
    "spoofVendingSdk": "0",
    "verboseLogs": "0"
}